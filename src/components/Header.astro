---
import { mainNav } from '../data/navigation';
import { googleMaps } from '../lib/google-maps';

const currentPath = Astro.url.pathname;

/** 取得目前頁面對應的主選單項目（路徑最長者優先，避免前綴互相覆蓋）。 */
const activeHref = [...mainNav]
  .sort((a, b) => b.href.length - a.href.length)
  .find((item) => currentPath === item.href || currentPath.startsWith(`${item.href}`))
  ?.href;
---

<header class="sticky top-0 z-40 border-b border-line bg-paper/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 md:px-6">
    <a href="/" class="flex items-center gap-3" aria-label="新化老街首頁">
      <svg
        class="h-9 w-9 shrink-0"
        viewBox="0 0 64 64"
        fill="none"
        aria-hidden="true"
      >
        <rect width="64" height="64" rx="14" fill="#8a4137" />
        <path
          d="M10 40h8l4-12 10-10 10 10 4 12h8"
          stroke="#f4efe5"
          stroke-width="3.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <circle cx="32" cy="30" r="3.5" stroke="#f4efe5" stroke-width="2.5" />
        <path d="M14 48h36" stroke="#b38950" stroke-width="3" stroke-linecap="round" />
      </svg>
      <span class="display-title text-lg font-bold">新化老街</span>
    </a>

    <nav aria-label="主選單" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {mainNav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={currentPath === item.href ? 'page' : undefined}
              class:list={[
                'rounded-full px-3 py-2 text-sm font-medium transition hover:bg-paper-deep',
                activeHref === item.href ? 'text-brick' : 'text-ink',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={googleMaps.place}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden items-center rounded-full bg-brick px-4 py-2 text-sm font-semibold text-white transition hover:bg-brick-dark sm:inline-flex"
      >
        開啟 Google 地圖
      </a>

      <details class="relative lg:hidden">
        <summary
          class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-full border border-line bg-paper [&::-webkit-details-marker]:hidden"
          aria-label="開啟選單"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </summary>
        <nav
          aria-label="行動版選單"
          class="absolute right-0 top-12 z-50 w-52 rounded-2xl border border-line bg-paper p-2 shadow-lg"
        >
          <ul>
            {mainNav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="block rounded-xl px-4 py-2.5 text-sm font-medium hover:bg-paper-deep"
                >
                  {item.label}
                </a>
              </li>
            ))}
            <li class="mt-1 border-t border-line pt-1">
              <a href="/map/" class="block rounded-xl px-4 py-2.5 text-sm font-medium text-brick hover:bg-paper-deep">
                地圖與導航
              </a>
            </li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
