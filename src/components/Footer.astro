---
import { footerNav } from '../data/navigation';
import { site } from '../data/site';
---

<footer class="border-t border-line bg-paper-deep">
  <div class="mx-auto max-w-6xl px-4 py-12 md:px-6">
    <div class="grid gap-10 md:grid-cols-[1.2fr_repeat(4,1fr)]">
      <div>
        <p class="display-title text-xl font-bold">新化老街</p>
        <p class="mt-1 text-sm text-ink-soft">Xinhua Old Street Guide</p>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-ink-soft">
          {site.tagline}。整理散步路線、美食、交通與歷史建築資訊，陪你走進臺南市新化區仍在生活中的百年街區。
        </p>
      </div>

      {footerNav.map((group) => (
        <nav aria-label={group.title}>
          <p class="text-sm font-semibold">{group.title}</p>
          <ul class="mt-3 space-y-2">
            {group.items.map((item) => (
              <li>
                <a href={item.href} class="text-sm text-ink-soft transition hover:text-brick">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <div class="mt-10 border-t border-line pt-6 text-xs leading-relaxed text-ink-soft">
      <p>© {new Date().getFullYear()} {site.domain} · 新化老街 · Xinhua Old Street Guide</p>
      <p class="mt-2">本網站所展示的所有圖片產權及版權均歸原攝影者所有。</p>
    </div>
  </div>
</footer>
