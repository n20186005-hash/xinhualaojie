---
interface Props {
  items: { q: string; a: string }[];
  title?: string;
}

const { items, title = '常見問題' } = Astro.props;
---

<section aria-label={title}>
  <h2 class="text-2xl font-bold md:text-3xl">{title}</h2>
  <div class="mt-6 divide-y divide-line rounded-3xl border border-line bg-white/50">
    {items.map((item) => (
      <details class="group px-6 py-4">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold [&::-webkit-details-marker]:hidden">
          {item.q}
          <span class="text-brass transition group-open:rotate-45" aria-hidden="true">＋</span>
        </summary>
        <p class="mt-3 leading-relaxed text-ink-soft">{item.a}</p>
      </details>
    ))}
  </div>
</section>
