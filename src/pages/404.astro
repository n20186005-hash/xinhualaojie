---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = '找不到頁面';
const description = '這個頁面不存在或已搬家。回到首頁，重新開始你的新化老街散步。';
---

<BaseLayout pageTitle={pageTitle} description={description} noindex>
  <div class="mx-auto flex max-w-3xl flex-col items-center px-4 py-24 text-center md:px-6">
    <p class="display-title text-7xl font-bold text-brass/60">404</p>
    <h1 class="mt-4 text-2xl font-bold md:text-3xl">找不到這個頁面</h1>
    <p class="mt-3 max-w-md leading-relaxed text-ink-soft">
      你要找的頁面不存在或已搬家。不如回到首頁，從頭規劃一趟新化老街散步。
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a
        href="/"
        class="inline-flex min-h-12 items-center rounded-full bg-brick px-6 py-3 font-semibold text-white transition hover:bg-brick-dark"
      >
        回到首頁
      </a>
      <a
        href="/routes/two-hours/"
        class="inline-flex min-h-12 items-center rounded-full border border-brick px-6 py-3 font-semibold text-brick transition hover:bg-brick/5"
      >
        兩小時散步路線
      </a>
    </div>
  </div>
</BaseLayout>
