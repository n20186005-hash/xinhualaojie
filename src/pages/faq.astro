---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FAQList from '../components/FAQList.astro';
import { breadcrumbSchema, faqSchema } from '../lib/schema';

const pageTitle = '新化老街常見問題';
const description =
  '新化老街值得去嗎？逛多久？怎麼停車？從臺南車站怎麼去？下雨天、帶小孩適不適合？一次回答規劃行程前最常見的問題。';

const faqGroups = [
  {
    title: '行程規劃',
    items: [
      {
        q: '新化老街值得去嗎？',
        a: '值得。新化老街保留整排巴洛克式街屋，而且仍是有市場、商店與居民生活的真實街區，加上步行可達的街役場、武德殿與大目降文化園區，適合安排半日的散步行程。',
      },
      {
        q: '新化老街大約逛多久？',
        a: '只逛老街本身約一小時；加上傳統市場、街役場與大目降文化園區，安排兩到三小時最剛好。若再串聯虎頭埤或新化林場，可以規劃一日遊。',
      },
      {
        q: '上午和下午哪個比較適合？',
        a: '推薦上午。傳統市場上午最熱鬧，早餐與小吃選擇多；夏天下午較熱，部分店家也在午後休息。傍晚光線斜射時則適合拍攝街屋立面。',
      },
      {
        q: '新化老街需要門票嗎？',
        a: '不需要。老街是開放的街區，全天可自由參觀；周邊的武德殿與大目降文化園區也是免費開放，個別展館的開放時間請以現場或官方公告為準。',
      },
      {
        q: '下雨天適合去嗎？',
        a: '可以。老街街屋設有騎樓，小雨時仍能沿騎樓散步；街役場、武德殿與紀念館都是室內或半室內空間，適合作為雨天的停留點。詳見本站雨天攻略。',
      },
      {
        q: '適合帶長輩或小孩嗎？',
        a: '適合。整條路線平坦、距離不長，沿途有騎樓遮蔭與休息點；建議放慢步調，把重點放在市場、街屋與文化園區，全程約兩小時內可完成。',
      },
    ],
  },
  {
    title: '交通與停車',
    items: [
      {
        q: '附近哪裡可以停車？',
        a: '老街周邊設有公有停車場與路邊停車格，建議把車停在外圍再步行進入，中正路老街段不適合邊開車邊找車位。詳細建議請看本站停車指南，即時車位請以 Google 地圖為準。',
      },
      {
        q: '從臺南車站怎麼前往？',
        a: '自駕走台20線約 30 分鐘；搭大眾運輸可在臺南車站附近搭乘往新化的公車，於新化站下車後步行即可抵達老街。班次請以 Google 地圖或公車動態資訊為準。',
      },
      {
        q: '從高鐵臺南站怎麼前往？',
        a: '高鐵臺南站距離新化約 20 分鐘車程，開車或搭計程車最方便；搭大眾運輸則需先接駁至市區再轉乘公車，建議以 Google 地圖查詢當下的最佳路線。',
      },
    ],
  },
  {
    title: '景點與美食',
    items: [
      {
        q: '新化老街和大目降文化園區是同一個地方嗎？',
        a: '不是同一個點，但步行只要幾分鐘。老街是中正路上的街屋群，大目降文化園區則是武德殿與日式宿舍群所在的文化聚落，兩者適合排進同一條散步路線。',
      },
      {
        q: '新化老街有什麼必吃？',
        a: '建議從市場周邊的早餐與小吃開始，再看看老字號糕餅與伴手禮。本站美食頁按早餐、市場小吃、糕餅與正餐分類整理，可依需求挑選。',
      },
      {
        q: '店家營業資訊去哪裡看？',
        a: '本站整理的是穩定的路線與看點；個別店家的營業時間、公休與菜單變動較快，出發前請直接在 Google 地圖查看店家頁面的最新資訊。',
      },
      {
        q: '虎頭埤離老街遠嗎？',
        a: '虎頭埤距離老街約 2 公里，開車約 5 分鐘，體力好也可以步行或騎自行車前往，很適合和老街組合成一日遊。',
      },
    ],
  },
];

const allFaq = faqGroups.flatMap((g) => g.items);

const schemas = [
  faqSchema(allFaq),
  breadcrumbSchema([
    { name: '首頁', path: '/' },
    { name: '常見問題', path: '/faq/' },
  ]),
];
---

<BaseLayout pageTitle={pageTitle} description={description} schemas={schemas}>
  <div class="mx-auto max-w-3xl px-4 py-10 md:px-6">
    <Breadcrumbs items={[{ name: '首頁', path: '/' }, { name: '常見問題' }]} />
    <h1 class="mt-4 text-3xl font-bold md:text-4xl">新化老街常見問題</h1>
    <p class="mt-3 leading-relaxed text-ink-soft">{description}</p>

    <div class="mt-10 space-y-10">
      {faqGroups.map((group) => (
        <FAQList items={group.items} title={group.title} />
      ))}
    </div>
  </div>
</BaseLayout>
