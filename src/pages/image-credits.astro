---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { imageCredits } from '../data/imageCredits';
import { breadcrumbSchema } from '../lib/schema';
import { site } from '../data/site';

const pageTitle = '圖片授權';
const description =
  `${site.domain} 使用的照片皆為 Wikimedia Commons 上以創用 CC 授權釋出的實地攝影作品，本頁列出每張照片的作者與授權條款。`;

const schemas = [
  breadcrumbSchema([
    { name: '首頁', path: '/' },
    { name: '圖片授權', path: '/image-credits/' },
  ]),
];
---

<BaseLayout pageTitle={pageTitle} description={description} schemas={schemas}>
  <div class="mx-auto max-w-4xl px-4 py-10 md:px-6">
    <Breadcrumbs items={[{ name: '首頁', path: '/' }, { name: '圖片授權' }]} />
    <h1 class="mt-4 text-3xl font-bold md:text-4xl">圖片授權</h1>
    <p class="mt-3 leading-relaxed text-ink-soft">
      本站使用的照片皆為攝影者實地拍攝、並於 Wikimedia Commons
      以創用 CC 授權釋出的作品。我們依各授權條款標示作者與出處；照片可能經過裁切與尺寸調整。點擊原始檔案連結可查看完整授權內容。
    </p>

    <div class="mt-8 overflow-x-auto rounded-2xl border border-line">
      <table class="w-full min-w-[640px] text-sm">
        <thead>
          <tr class="bg-paper-deep text-left">
            <th class="px-4 py-3 font-semibold">照片</th>
            <th class="px-4 py-3 font-semibold">作者</th>
            <th class="px-4 py-3 font-semibold">授權條款</th>
            <th class="px-4 py-3 font-semibold">原始檔案</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line bg-white/50">
          {imageCredits.map((credit) => (
            <tr>
              <td class="px-4 py-3">{credit.title}</td>
              <td class="px-4 py-3">{credit.author}</td>
              <td class="px-4 py-3">
                {credit.licenseUrl ? (
                  <a
                    href={credit.licenseUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-brick hover:underline"
                  >
                    {credit.license}
                  </a>
                ) : (
                  credit.license
                )}
              </td>
              <td class="px-4 py-3">
                <a
                  href={credit.source}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-patina hover:underline"
                >
                  Wikimedia Commons ↗
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="mt-6 text-sm leading-relaxed text-ink-soft">
      若你是照片作者，對標示方式有任何疑問或希望調整，請透過
      <a href="/contact/" class="font-semibold text-brick hover:underline">聯絡頁面</a>
      與我們聯繫，我們會儘速處理。
    </p>
  </div>
</BaseLayout>
