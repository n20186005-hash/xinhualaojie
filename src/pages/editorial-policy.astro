---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Prose from '../components/Prose.astro';
import { breadcrumbSchema } from '../lib/schema';
import { site } from '../data/site';

const pageTitle = '內容維護政策';
const description =
  `說明 ${site.domain} 的內容整理方式：哪些資訊由本站維護、哪些資訊連結至 Google 地圖與相關單位查詢。`;

const schemas = [
  breadcrumbSchema([
    { name: '首頁', path: '/' },
    { name: '內容維護政策', path: '/editorial-policy/' },
  ]),
];
---

<BaseLayout pageTitle={pageTitle} description={description} schemas={schemas}>
  <div class="mx-auto max-w-3xl px-4 py-10 md:px-6">
    <Breadcrumbs items={[{ name: '首頁', path: '/' }, { name: '內容維護政策' }]} />
    <h1 class="mt-4 text-3xl font-bold md:text-4xl">內容維護政策</h1>

    <div class="mt-8">
      <Prose>
        <h2>由本站維護的內容</h2>
        <p>以下資訊相對穩定，由本站撰寫並持續修訂：</p>
        <ul>
          <li>街區的歷史與地名由來；</li>
          <li>街屋的建築特色與看點；</li>
          <li>景點之間的相對位置與步行關係；</li>
          <li>散步路線的順序與建議停留時間；</li>
          <li>各路線適合的客群與季節建議。</li>
        </ul>

        <h2>請以 Google 地圖為準的內容</h2>
        <p>以下資訊變動較快，本站不逐一登載，一律提供 Google 地圖連結：</p>
        <ul>
          <li>店家是否營業、公休與臨時休息；</li>
          <li>店家評分、評論數與菜單；</li>
          <li>店家電話與訂位方式；</li>
          <li>即時路線、車程與路況；</li>
          <li>停車場的即時車位狀態。</li>
        </ul>

        <h2>更正與回饋</h2>
        <p>
          如果你發現內容有誤，或有更好的在地資訊，歡迎透過<a href="/contact/">聯絡頁面</a>告訴我們，我們會盡快查證並修訂。
        </p>
      </Prose>
    </div>
  </div>
</BaseLayout>
